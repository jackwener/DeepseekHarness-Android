<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds: GWP-ASan on every allocation-sampling slot in all processes (incl. :engine), so heap
     corruption (suspected in native addons / OpenSSL) produces a precise tombstone "Cause:" line. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:gwpAsanMode="always" tools:targetApi="30">
        <!-- Non-exported deterministic native UI for connected tests; absent from release builds. -->
        <activity android:name=".testing.PhoneFixtureActivity" android:exported="false" android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
